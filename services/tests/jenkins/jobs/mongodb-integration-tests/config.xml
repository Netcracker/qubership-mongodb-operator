    </hudson.plugins.robot.RobotPublisher>
    <org.jenkinsci.plugins.postbuildscript.PostBuildScript plugin="postbuildscript@2.7.0">
      <config>
        <scriptFiles/>
        <groovyScripts/>
        <buildSteps>
          <org.jenkinsci.plugins.postbuildscript.model.PostBuildStep>
            <results>
              <string>SUCCESS</string>
              <string>NOT_BUILT</string>
              <string>ABORTED</string>
              <string>FAILURE</string>
              <string>UNSTABLE</string>
            </results>
            <role>BOTH</role>
            <buildSteps>
              <hudson.tasks.Shell>
                <command>KUBECONFIG=&quot;$(pwd)/config&quot;
export KUBECONFIG

rm -rf config
touch config

if [[ -z &quot;${OPENSHIFT_TOKEN}&quot; ]];
then
    oc login &quot;https://${CLOUD_URL}:8443&quot; -u &quot;${OPENSHIFT_USER}&quot; \
            -p &quot;${OPENSHIFT_PASSWORD}&quot; --insecure-skip-tls-verify
    OPENSHIFT_TOKEN=$(oc whoami -t)
else
    oc login &quot;https://${CLOUD_URL}:8443&quot; --token &quot;${OPENSHIFT_TOKEN}&quot; \
       --insecure-skip-tls-verify
fi

if [[ -z &quot;${OPENSHIFT_WORKSPACE}&quot; ]];
then
    export OPENSHIFT_WORKSPACE=&quot;mongodb-cluster&quot;
fi

oc project ${OPENSHIFT_WORKSPACE}

oc delete dc/mongo-tests || true</command>
              </hudson.tasks.Shell>
            </buildSteps>
          </org.jenkinsci.plugins.postbuildscript.model.PostBuildStep>
        </buildSteps>
        <markBuildUnstable>false</markBuildUnstable>
      </config>
    </org.jenkinsci.plugins.postbuildscript.PostBuildScript>
