  <builders>
    <hudson.tasks.Shell>
      <command>set -x

eval $(cat ${JENKINS_HOME}/manifests/prod.platform.databases_mongodb-l2ci/${VERSION}/env.properties | grep mongo_tests)

if [[ -z $TEST_IMAGE ]] &amp;&amp; [[ ! -z ${mongo_tests} ]]; then 
    export TEST_IMAGE=${mongo_tests}
fi

zipinfo ${JENKINS_HOME}/manifests/prod.platform.databases_mongodb-l2ci/${VERSION}/application.zip
unzip -o ${JENKINS_HOME}/manifests/prod.platform.databases_mongodb-l2ci/${VERSION}/application.zip &apos;prod.platform.databases_mongodb-l2ci/mongo-tests/*&apos; || true
cd prod.platform.databases_mongodb-l2ci/mongo-tests/ || true

KUBECONFIG=&quot;$(pwd)/config&quot;
export KUBECONFIG

chmod +x ./integration-tests/run.sh
                ./integration-tests/run.sh</command>
    </hudson.tasks.Shell>
