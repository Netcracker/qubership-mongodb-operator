{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/compact/{dbName}": {
            "post": {
                "description": "Compacts all collections in the database",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Operator API"
                ],
                "summary": "Compact all",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Databases to compact all collections in",
                        "name": "dbName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/compact/{dbName}/{collectionName}": {
            "post": {
                "description": "Compacts the collection in the database",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Operator API"
                ],
                "summary": "Compact",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Databases to compact collection in",
                        "name": "dbName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "collectionName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/flush": {
            "post": {
                "description": "Flushes data from RAM to disks",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Operator API"
                ],
                "summary": "Flush data",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns up/down/degraded health status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Operator API"
                ],
                "summary": "Get Mongo Cluster Health",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/fiber.Status"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/keyfile": {
            "get": {
                "description": "Returns list of all existing databases in all namespaces",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Operator API"
                ],
                "summary": "Get Mongo Key File",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/rs-status": {
            "get": {
                "description": "Returns output of rs.status()",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Operator API"
                ],
                "summary": "Get Mongo Replica sets status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "fiber.Status": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                }
            }
        }
    }
}